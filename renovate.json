{
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["main"],
  "branchPrefix": "renovate/",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies", "bot"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "groupName": "javascript-dependencies",
      "groupSlug": "javascript-dependencies",
      "separateMinorPatch": false
    },
    {
      "matchDatasources": ["pip"],
      "groupName": "python-dependencies",
      "groupSlug": "python-dependencies",
      "separateMinorPatch": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "separateMinorPatch": false
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "docker-dependencies",
      "groupSlug": "docker-dependencies",
      "separateMinorPatch": false
    },
    {
      "description": "Automerge non-major updates once required CI checks pass. minimumReleaseAge + branch protection are the safety net.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major updates always need a human. Keep this rule last: within a grouped branch, automerge=false on any single upgrade wins, so a group that contains a major is not automerged either.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "automergeType": "pr",
  "automergeStrategy": "merge-commit",
  "platformAutomerge": true
}
